<?xml version="1.0" encoding="UTF-8"?>
<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <Bundle
        Name="Ice Services $(Version)"
        Manufacturer="ZeroC, Inc."
        Version="$(Version).0"
        UpgradeCode="D5F84B22-7A9E-4C1A-8B6D-3E8F1A2C5D7B"
        IconSourceFile="!(bindpath.SOURCE_ROOT)packaging\windows-installer\resources\product.ico">

        <!-- WixInternalUIBootstrapperApplication delegates all UI to the MSI's own dialogs.
             Burn silently handles prerequisite detection/install (VC++ Redist), then launches
             the MSI with full UI (license, install dir, PATH checkbox, release notes). -->
        <BootstrapperApplication>
            <bal:WixInternalUIBootstrapperApplication />
        </BootstrapperApplication>

        <Chain>
            <!-- VC++ 2015-2022 Redistributable (x64) — installed silently; vc_redist.x64.exe
                 handles already-installed and upgrade scenarios internally. -->
            <ExePackage
                Id="VCRedist_x64"
                Name="vc_redist.x64.exe"
                SourceFile="!(bindpath.VCREDIST_DIR)vc_redist.x64.exe"
                PerMachine="yes"
                Permanent="yes"
                Vital="yes"
                Protocol="burn"
                InstallArguments="/install /quiet /norestart"
                RepairArguments="/repair /quiet /norestart"
                UninstallArguments="/uninstall /quiet /norestart" />

            <!-- Ice Services MSI — the MSI's internal UI handles all user interaction -->
            <MsiPackage
                Id="IceServicesMsi"
                SourceFile="!(bindpath.ICE_MSI_DIR)Ice-Services-$(IcePackageVersion).msi"
                Vital="yes" />
        </Chain>
    </Bundle>
</Wix>
